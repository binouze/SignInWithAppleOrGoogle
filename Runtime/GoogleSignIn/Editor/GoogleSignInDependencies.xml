<?xml version="1.0" encoding="UTF-8" ?>
<dependencies>
  <!-- See https://github.com/googlesamples/unity-jar-resolver#usage for
    how to configure dependencies -->
  <!-- Android : versions figees (pas de +) : une version dynamique peut tirer une lib qui exige un compileSdk, un AGP
    ou un Kotlin plus recent que ceux d'Unity, et casser le build sans changement de notre cote.
    googleid bloque en 1.2.0 : la 1.2.1 est compilee en Kotlin 2.4, illisible par le Kotlin d'AGP 9.0 (Unity 6000.3). -->
  <androidPackages>
    <androidPackage spec="androidx.credentials:credentials:1.6.0"/>
    <androidPackage spec="androidx.credentials:credentials-play-services-auth:1.6.0"/>
    <androidPackage spec="com.google.android.libraries.identity.googleid:googleid:1.2.0"/>
    <androidPackage spec="org.json:json:20220320"/>
  </androidPackages>

  <!-- iOS : Swift Package en priorite (Swift Package Manager actif dans EDM), le pod reste en repli.
    En SPM, GoogleSignIn-iOS et firebase-ios-sdk pointent sur le meme repo GoogleUtilities :
    SPM le dedoublonne, la ou le pod GoogleSignIn le reintroduisait a cote de Firebase en SPM. -->
  <remoteSwiftPackage url="https://github.com/google/GoogleSignIn-iOS.git" version="9.2.0" upToNextMajor="true">
    <swiftPackage name="GoogleSignIn" replacesPod="GoogleSignIn"/>
  </remoteSwiftPackage>

  <!-- iOS Cocoapod dependencies can be specified by each iosPod element. -->
  <iosPods>
    <iosPod name="GoogleSignIn" version="~> 9.0" bitcodeEnabled="false"
        minTargetSdk="13.0">
    </iosPod>
  </iosPods>
</dependencies>
